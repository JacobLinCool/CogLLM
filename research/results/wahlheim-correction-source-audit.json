  "paper": "https://doi.org/10.3758/s13421-025-01760-7",
  "shared_topics_across_experiments": 48,
  "source_reconciliation": {
    "geometry": "The author example in Figure 2 identifies role layout. Each slide XML contains one unique false baseline headline in the upper left and true baseline headline in the upper right. The lower middle correction and lower right affirmation reuse the true baseline string. The lower left editable text supplies the false-warning label but no separate full headline string.",
    "mapping": "A manually specified set of topic terms was checked against the union of words in each slide’s two headline shapes. All 48 term sets produce exactly one match and cover every topic slide. This content crosswalk has no explicit slide number in the tidy rows.",
    "multimodal": "All 48 material slides also contain Picture elements. Figures 2 and 3 document image and label presentation. Source components outside editable text and the exact deployed Qualtrics payload were not reconstructed.",
    "outcome_join": "The E1 preprocessor reshapes paired stimN_name and stimN_group fields and joins outcomes across phases. Both tidy datasets contain one complete row per reader and topic.",
    "rights": "Publisher licenses the article CC BY 4.0, subject to third-party credit-line exceptions. OSF project API has no populated license relationship. A reuse license for the standalone deck and each image was not verified.",
    "text_hash_normalization": "Join runs within each text paragraph, then join paragraphs and collapse whitespace to one ASCII space. Preserve capitalization and punctuation. Hash UTF-8 with SHA-256.",
    "trial_order": "The E1 preprocessor drops generated Subtrial and Random_Number fields. The public tidy page-submit fields supply elapsed times on specified pages, not a verified randomized display chronology. Figure 1 and Methods certify the assigned variant, phase ordering, and false-then-true order within its combined correction."
  },
  "study": "Wahlheim, Kemp, Wiley, and Engelhardt (2025)",
  "timing_and_ratings": {
    "behavioral_scope": "Repeated memory and belief about an explicitly prompted headline. No responses at word boundaries or after either individual correction image, and no reports of spontaneously raised questions.",
    "delay_discrepancy": "Methods reports 29.98 mean days for Experiment 2. The tidy file gives 28.978 days with the same reported range and SD. Both stored hour and day columns independently give 28.978 days. Cause unverified.",
    "mean_definition": "Descriptive empirical arithmetic averages over retained reader-topic rows, without weighting topics or fitting the published mixed-effects models. A lower accuracy rating means less belief in the original presented claim, whose truth differs by condition.",
    "phase_1": "Original unlabeled headline for 8 s, then 1–4 perceived accuracy and 1–4 topic familiarity.",
    "phase_2": "One or two successive correction or affirmation images for 8 s each, with no judgment collected. The 16 s available for two panels is confounded with correction format. Filler topics have no exposure in this phase.",
    "phase_3": "After the entire phase 2 block, rate the re-presented original headline for perceived accuracy (1 least to 4 most) and recognition of correction (1 certain no to 4 certain yes).",
    "phase_4": "Re-present and rate the same original headline with the same anchors after the retention interval in a second session."
  },
